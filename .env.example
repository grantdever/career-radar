# ==============================================================================
# Career Radar - Environment Variables Example
# ==============================================================================

# --- LLM Provider API Keys ---
# Provide at least one key for your preferred scoring and universal scraping LLM.
# Defaults to gpt-4o-mini via LiteLLM.
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="..."

# --- Public ATS Integration Credentials ---
# USAJOBS Search API (free registration at https://developer.usajobs.gov/)
USAJOBS_API_KEY=""
USAJOBS_USER_AGENT="your-email@example.com"

# Adzuna Search API (free registration at https://developer.adzuna.com/)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# --- Local Storage & Configuration Overrides (Optional) ---
# Override default configuration directory (~/.config/career-radar)
# CAREER_RADAR_CONFIG_DIR="/path/to/custom/config"

# Override default SQLite database path (~/.local/share/career-radar/scanner.db)
# CAREER_RADAR_DB_PATH="/path/to/custom/scanner.db"
